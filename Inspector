def as_int(v):
    if isinstance(v, str):
        v = v.strip()
        return int(v, 16) if v.lower().startswith("0x") else int(v)
    return int(v)

def fetch_version():
    try:
        r = requests.get(ROBLOX_VERSION_URL, timeout=10)
        r.raise_for_status()
        v = str((r.json() or {}).get("clientVersionUpload", "")).strip()
        return v
    except Exception as e:
        rep("FAIL", f"could not fetch Roblox version: {e}", "system")
        return ""

def fetch_expected(version):
    urls = [OFFSETS_URL.format(version=version), OFFSETS_URL_JSON.format(version=version)] if version else []
    for url in urls:
        try:
            r = requests.get(url, timeout=10)
            r.raise_for_status()
            data = r.json()
            if isinstance(data, dict) and data.get("Offsets"):
                return data, url
            if isinstance(data, dict) and len(data) > 10:
                return {"Offsets": {"Misc": data}}, url
        except Exception:
            continue
    return None, ""

def load_local():
    for p in (OFFSETS_PATH, CACHE_PATH):
        if os.path.isfile(p):
            try:
                with open(p, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, dict) and data.get("offsets") and not data.get("Offsets"):
                    data = data["offsets"]
                if data:
                    return data, p
            except Exception as e:
                rep("WARN", f"{os.path.basename(p)} exists but invalid JSON: {e}", "system")
    return None, ""

def flat_offsets(data):
    out = {}
    if not isinstance(data, dict):
        return out
    groups = data.get("Offsets") if isinstance(data.get("Offsets"), dict) else data
    for gk, gv in groups.items():
        if isinstance(gv, dict):
            for k, v in gv.items():
                try:
                    out[str(k).lower()] = (f"{gk}.{k}", as_int(v))
                except Exception:
                    pass
        else:
            try:
                out[str(gk).lower()] = (str(gk), as_int(gv))
            except Exception:
                pass
    return out

def check_offsets_diff(expected, local, local_src):
    exp = flat_offsets(expected)
    loc = flat_offsets(local)
    if not exp:
        rep("FAIL", "expected offsets empty, cannot compare", "system")
        return False
    if not loc:
        rep("FAIL", f"{local_src} has no usable offsets", "system")
        return False
    changed, missing, extra = [], [], []
    for k, (ename, eval_) in exp.items():
        if k not in loc:
            missing.append(ename)
        elif loc[k][1] != eval_:
            changed.append(f"{ename}: local={hex(loc[k][1])} expected={hex(eval_)}")
    for k, (lname, _) in loc.items():
        if k not in exp:
            extra.append(lname)
    if changed:
        rep("FAIL", f"offsets CHANGED ({len(changed)}):", "system")
        for c in changed[:20]:
            print(f"       - {c}")
    else:
        rep("OK", "no changed offset values", "system")
    if missing:
        rep("WARN", f"{len(missing)} offsets missing locally", "system")
    if extra:
        rep("WARN", f"{len(extra)} extra local offsets", "system")
    return not changed

_U3F = struct.Struct("<3f").unpack_from
_pm = None
_base = None
_pid = -1
_offdata = {}

def _off(group, field, default=0):
    try:
        data = _offdata.get("Offsets", _offdata) if isinstance(_offdata, dict) else {}
        if not isinstance(data, dict):
            return default
        g = None
        for k, v in data.items():
            if isinstance(k, str) and k.lower() == group.lower():
                g = v
                break
        if isinstance(g, dict):
            for k, v in g.items():
                if isinstance(k, str) and k.lower() == field.lower():
                    return as_int(v)
        for gv in data.values():
            if isinstance(gv, dict):
                for k, v in gv.items():
                    if isinstance(k, str) and k.lower() == field.lower():
                        return as_int(v)
    except Exception:
        pass
    return default

def _read_string(addr):
    try:
        ln = _pm.read_int(addr + 0x18)
        if ln >= 16:
            addr = _pm.read_longlong(addr)
        if not addr or addr < 0x10000:
            return ""
        raw = _pm.read_bytes(addr, min(max(ln if 0 < ln < 256 else 64, 8), 256))
        return raw.split(b"\x00", 1)[0].decode("utf-8", errors="ignore")
    except Exception:
        return ""

class Inst:
    __slots__ = ("a",)
    def __init__(self, a=0):
        self.a = a
    def __bool__(self):
        return self.a != 0
    def name(self):
        try:
            nc = _pm.read_longlong(self.a + _off("Instance", "NameContainer"))
            if nc and nc >= 0x10000:
                s = _read_string(nc + _off("Instance", "Name"))
                if s:
                    return s
        except Exception:
            pass
        return ""
    def cls(self):
        try:
            d = _pm.read_longlong(self.a + _off("Instance", "ClassDescriptor"))
            return _read_string(_pm.read_longlong(d + _off("Instance", "ClassName")))
        except Exception:
            return ""
    def children(self):
        out = []
        try:
            cs = _pm.read_longlong(self.a + _off("Instance", "ChildrenStart"))
            if not cs:
                return out
            ce = _pm.read_longlong(cs + _off("Instance", "ChildrenEnd"))
            start = _pm.read_longlong(cs)
            c = start
            guard = 0
            while c < ce and guard < 5000:
                out.append(Inst(_pm.read_longlong(c)))
                c += 0x10
                guard += 1
        except Exception:
            pass
        return out
    def child_class(self, want):
        for ch in self.children():
            try:
                if ch.cls() == want:
                    return ch
            except Exception:
                continue
        return Inst(0)
    def child_name(self, want):
        for ch in self.children():
            try:
                if ch.name() == want:
                    return ch
            except Exception:
                continue
        return Inst(0)
    def pos(self):
        try:
            return _U3F(_pm.read_bytes(self.a + _off("Primitive", "Position"), 12))
        except Exception:
            return None
    def size(self):
        try:
            prim = _pm.read_longlong(self.a + _off("BasePart", "Primitive"))
            if not prim or prim < 0x10000:
                return None
            return _U3F(_pm.read_bytes(prim + _off("Primitive", "Size"), 12))
        except Exception:
            return None

def attach():
    global _pm, _base, _pid
    cands = []
    for p in list_processes():
        try:
            n = p.szExeFile.decode(errors="ignore")
        except Exception:
            continue
        nl = n.lower()
        if "roblox" in nl and "crashhandler" not in nl:
            cands.append((n, int(p.th32ProcessID)))
    if not cands:
        rep("FAIL", "no Roblox process found (open Roblox first)", "system")
        return False
    cands.sort(key=lambda x: 0 if "robloxplayerbeta" in x[0].lower() else 1)
    for name, pid in cands:
        try:
            pm = Pymem()
            pm.open_process_from_id(pid)
            base = None
            for m in pm.list_modules():
                if "roblox" in m.name.lower():
                    base = m.lpBaseOfDll
                    break
            if base is None:
                base = getattr(pm, "base_address", None)
            pm.read_bytes(base, 1)
            _pm, _base, _pid = pm, base, pid
            rep("OK", f"attached to {name} pid={pid} base={hex(base)}", "system")
            return True
        except Exception as e:
            try:
                pm.close_process()
            except Exception:
                pass
    rep("FAIL", "found Roblox but could not open it (run checker as admin)", "system")
    return False

def find_datamodel():
    for cand in (0x5A0, 0x5A8, 0x5B0, 0x5B8, 0x5C0, 0x588, 0x590, 0x598):
        try:
            ptr = _pm.read_longlong(_base + cand)
            if ptr and ptr >= 0x10000:
                i = Inst(ptr)
                if i.child_class("Workspace") and i.child_class("Players"):
                    return ptr, f"base+{hex(cand)}"
        except Exception:
            continue
    try:
        fake = _pm.read_longlong(_base + _off("FakeDataModel", "Pointer"))
        if fake and fake >= 0x10000:
            dm = _pm.read_longlong(fake + _off("FakeDataModel", "RealDataModel"))
            if dm and dm >= 0x10000 and Inst(dm).child_class("Workspace"):
                return dm, "FakeDataModel"
    except Exception:
        pass
    return 0, ""

def check_fflag_mem(name, default):
    global fflag_results
    try:
        r = requests.get(FFLAGS_URL, timeout=8)
        theo = r.json()["FFlagOffsets"]["FFlags"]
    except Exception as e:
        rep("WARN", f"FFlag offset list fetch failed: {e}", "fflag")
        return
    off = None
    for k in (name, name.lower(), name.upper()):
        if k in theo:
            off = theo[k]
            break
    if off is None:
        bare = name[5:] if name.startswith("DFInt") else (name[4:] if name.startswith("FInt") else name)
        off = theo.get(bare)
    if off is None:
        rep("WARN", f"FFlag {name}: offset unknown", "fflag")
        return
    try:
        cur = struct.unpack("<i", _pm.read_bytes(_base + as_int(off), 4))[0]
    except Exception as e:
        rep("WARN", f"{name}: unreadable ({e})", "fflag")
        return
    
    status = "OK" if cur == default else "FAIL"
    fflag_results[name] = {
        "normal": default,
        "current": cur,
        "status": status
    }

    if cur == default:
        rep("OK", f"{name} = {cur} (clean)", "fflag")
    else:
        rep("FAIL", f"{name} = {cur} (MODIFIED in memory, clean={default})", "fflag")

def run_checker(send_webhook=True, is_initial=False, is_monitoring_event=False):
    global results, _offdata, reach_results, fflag_results, detected_roblox_user
    results = []
    reach_results = {}
    fflag_results = {}
    detected_roblox_user = "Unknown / Not In-Game"
    
    version = fetch_version()
    expected, url = fetch_expected(version) if version else (None, "")
    local, src = load_local()
    if expected and local:
        check_offsets_diff(expected, local, os.path.basename(src))
    elif expected and not local:
        rep("WARN", "no local offsets file to compare", "system")
    else:
        rep("FAIL", "no expected offsets (offline?)", "system")

    _offdata = expected or local or {}
    if not _offdata:
        rep("FAIL", "no offsets at all, stopping", "system")
        if send_webhook:
            send_discord_summary(results, is_alert=True, is_monitoring_event=is_monitoring_event)
        return results

    if not attach():
        if send_webhook:
            send_discord_summary(results, is_alert=True, is_monitoring_event=is_monitoring_event)
        return results

    dm, how = find_datamodel()
    if not dm:
        rep("FAIL", "DataModel NOT found", "system")
    else:
        rep("OK", f"DataModel ok via {how} ({hex(dm)})", "system")
        ws = Inst(dm).child_class("Workspace")
        pl = Inst(dm).child_class("Players")
        rep("OK" if ws else "FAIL", "Workspace present" if ws else "Workspace MISSING", "system")
        rep("OK" if pl else "FAIL", "Players present" if pl else "Players MISSING", "system")
        if pl:
            try:
                lp_ptr = _pm.read_longlong(pl.a + _off("Player", "LocalPlayer"))
                lp = Inst(lp_ptr)
                if not lp or not lp.a:
                    rep("WARN", "LocalPlayer null", "reach")
                else:
                    try:
                        name_val = lp.name()
                        if name_val:
                            detected_roblox_user = name_val
                    except Exception:
                        pass

                    ch = Inst(_pm.read_longlong(lp.a + _off("Player", "ModelInstance")))
                    if not ch or not ch.a:
                        rep("WARN", "no Character", "reach")
                    else:
                        parts_to_check = {
                            "hrp": (["HumanoidRootPart"], "(2.0, 2.0, 1.0)", (2.5, 2.5, 1.5)),
                            "head": (["Head"], "(2.0, 1.0, 1.0)", (4.5, 2.5, 4.5)),
                            "left_leg": (["Left Leg", "LeftLeg", "LeftLowerLeg", "LeftFoot"], "(1.0, 2.0, 1.0)", (2.0, 3.0, 2.0)),
                            "right_leg": (["Right Leg", "RightLeg", "RightLowerLeg", "RightFoot"], "(1.0, 2.0, 1.0)", (2.0, 3.0, 2.0)),
                            "left_arm": (["Left Arm", "LeftArm", "LeftLowerArm", "LeftHand"], "(1.0, 2.0, 1.0)", (2.0, 3.0, 2.0)),
                            "right_arm": (["Right Arm", "RightArm", "RightLowerArm", "RightHand"], "(1.0, 2.0, 1.0)", (2.0, 3.0, 2.0))
                        }

                        for part_key, (possible_names, normal_str, lims) in parts_to_check.items():
                            part_inst = Inst(0)
                            for p_name in possible_names:
                                part_inst = ch.child_name(p_name)
                                if part_inst and part_inst.a:
                                    break
                                    
                            if part_inst and part_inst.a:
                                p_size = part_inst.size()
                                if p_size:
                                    cur_str = f"[{p_size[0]:.1f}, {p_size[1]:.1f}, {p_size[2]:.1f}]"
                                    bad_now = (p_size[0] > lims[0] or p_size[1] > lims[1] or p_size[2] > lims[2])
                                    status = "FAIL" if bad_now else "OK"
                                    
                                    reach_results[part_key] = {
                                        "name": part_key.upper(),
                                        "normal": normal_str,
                                        "current": cur_str,
                                        "status": status
                                    }
                                    
                                    if bad_now:
                                        rep("FAIL", f"{part_key.upper()} size MODIFIED: ({p_size[0]:.1f},{p_size[1]:.1f},{p_size[2]:.1f})", "reach")
                                    else:
                                        rep("OK", f"{part_key.upper()} size clean ({p_size[0]:.1f},{p_size[1]:.1f},{p_size[2]:.1f})", "reach")
                            else:
                                rep("WARN", f"{part_key.upper()} not found", "reach")

            except Exception as e:
                rep("WARN", f"character walk failed: {e}", "reach")

    check_fflag_mem("FIntInterpolationMaxDelayMSec", 500)
    check_fflag_mem("DFIntTargetTimeDelayFacctorTenths", 20)
    check_fflag_mem("DFIntMaxFrameBufferSize", 10)
    check_fflag_mem("DFIntS2PhysicsSenderRate", 15)

    try:
        _pm.close_process()
    except Exception:
        pass
        
    if send_webhook:
        has_fails = any(s == "FAIL" for s, _, _ in results)
        if is_monitoring_event:
            if has_fails:
                send_discord_summary(results, is_alert=True, is_monitoring_event=True)
        else:
            if is_initial or has_fails:
                send_discord_summary(results, is_alert=has_fails, is_monitoring_event=False)
            
    return results

