        self.txt_log.tag_configure("FAIL", foreground="#ff5555", font=("Consolas", 10, "bold"))
        self.txt_log.tag_configure("WARN", foreground="#ffb86c")
        self.txt_log.tag_configure("INFO", foreground="#8be9fd")
        self.txt_log.tag_configure("SEP", foreground="#666666")

    def start_scan(self):
        self.status_lbl.config(text="Status: Scanning...", foreground="#ffb86c")
        self.btn_run.config(state=tk.DISABLED)
        threading.Thread(target=self._run_thread, daemon=True).start()

    def _run_thread(self):
        logs = run_checker(send_webhook=True, is_initial=True, is_monitoring_event=False)
        self.root.after(0, self.update_ui, logs)

    def toggle_monitoring(self):
        global is_monitoring
        if not is_monitoring:
            is_monitoring = True
            self.btn_monitor.config(text="🔴 Stop Monitoring")
            self.status_lbl.config(text="Status: Monitoring Active...", foreground="#50fa7b")
            threading.Thread(target=send_toggle_status_to_discord, args=("Monitoring Started [ON]",), daemon=True).start()
            threading.Thread(target=self._monitoring_loop, daemon=True).start()
        else:
            is_monitoring = False
            self.btn_monitor.config(text="🟢 Start Monitoring")
            self.status_lbl.config(text="Status: Monitoring Stopped", foreground="#ffb86c")
            threading.Thread(target=send_toggle_status_to_discord, args=("Monitoring Stopped [OFF]",), daemon=True).start()

    def _monitoring_loop(self):
        global is_monitoring
        while is_monitoring:
            try:
                run_checker(send_webhook=True, is_initial=False, is_monitoring_event=True)
            except Exception:
                pass
            for _ in range(50):
                if not is_monitoring:
                    break
                time.sleep(0.1)

    def update_ui(self, logs):
        if not is_monitoring:
            self.btn_run.config(state=tk.NORMAL)
            
        fails = sum(1 for s, msg, cat in logs if s == "FAIL")
        if fails > 0:
            self.status_lbl.config(text="Status: illegal (Cheats Detected!)", foreground="#ff5555")
        elif not is_monitoring:
            self.status_lbl.config(text="Status: legal (No Cheats Detected)", foreground="#50fa7b")
            
        for item in self.tree_reach.get_children():
            self.tree_reach.delete(item)
        for part, data in reach_items if 'reach_items' in locals() else reach_results.items():
            tag = "bad" if data["status"] == "FAIL" else "clean"
            self.tree_reach.insert("", tk.END, values=(data["name"], data["normal"], data["current"], data["status"]), tags=(tag,))

        for item in self.tree_fflag.get_children():
            self.tree_fflag.delete(item)
        for flag, data in fflag_results.items():
            tag = "bad" if data["status"] == "FAIL" else "clean"
            self.tree_fflag.insert("", tk.END, values=(flag, data["normal"], data["current"], data["status"]), tags=(tag,))

        self.txt_log.delete("1.0", tk.END)
        
        system_logs = [l for l in logs if l[2] == "system"]
        reach_logs = [l for l in logs if l[2] == "reach"]
        fflag_logs = [l for l in logs if l[2] == "fflag"]

        def insert_group(group_logs):
            for st, msg, cat in group_logs:
                start_idx = self.txt_log.index(tk.END)
                self.txt_log.insert(tk.END, f"[{st}] [{cat.upper()}] ")
                end_tag_idx = self.txt_log.index(tk.END)
                self.txt_log.insert(tk.END, f"{msg}\n")
                if st in ("OK", "FAIL", "WARN"):
                    self.txt_log.tag_add(st, start_idx, end_tag_idx)

        if system_logs:
            insert_group(system_logs)
            
        if reach_logs:
            if system_logs:
                sep_idx = self.txt_log.index(tk.END)
                self.txt_log.insert(tk.END, "────────────────────────────────────────────────────────────────────────\n")
                self.txt_log.tag_add("SEP", sep_idx, self.txt_log.index(tk.END))
            insert_group(reach_logs)
            
        if fflag_logs:
            if system_logs or reach_logs:
                sep_idx = self.txt_log.index(tk.END)
                self.txt_log.insert(tk.END, "────────────────────────────────────────────────────────────────────────\n")
                self.txt_log.tag_add("SEP", sep_idx, self.txt_log.index(tk.END))
            insert_group(fflag_logs)

def main():
    # فتح واجهة الـ GUI بشكل إجباري ومستقل دائماً عند التشغيل
    root = tk.Tk()
    app = CheckerGUI(root)
    root.mainloop()

if __name__ == "__main__":
    main()
